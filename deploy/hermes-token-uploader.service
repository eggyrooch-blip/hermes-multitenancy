# 工件1b：每小时把 Hermes token 台账聚合+解析+上报到排行榜收集端。
# 安装到 hermes-1（跑 hermes 用户）。占位符（@...@ / <...>）部署时按 README.md 替换。
[Unit]
Description=Hermes token usage -> enterprise leaderboard uploader
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 作为 hermes 用户的 user unit 安装（systemctl --user，见 README），故不设 User=；
# 若改成 system-level 安装，请在此加回 User=hermes 并用 `systemctl enable`（非 --user）。
# 上报 Bearer（与员工 Mac MDM 同一把，收集端 COLLECTOR_API_TOKENS 之一）。
Environment=HERMES_TOKSCALE_REPORT_KEY=<tokscale-report-key>
# 邮箱域名（必填）：email = <user_id>@<域名>，全公司排行榜统一身份键。
Environment=HERMES_TOKEN_USAGE_EMAIL_DOMAIN=keep.com
# 以下有默认值，按需覆盖：
# Environment=HERMES_TOKSCALE_COLLECTOR=https://tokscale.gotokeep.com
# Environment=HERMES_TOKEN_USAGE_LEDGER_PATH=/var/log/hermes/token-usage.jsonl
# Environment=HERMES_MULTITENANCY_DB=/home/hermes/.hermes/multitenancy.db
ExecStart=@PYTHON@ -m hermes_multitenancy.token_usage_uploader
Nice=10
IOSchedulingClass=idle
