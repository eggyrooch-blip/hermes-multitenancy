+    cleanupServer = null
+  })
+
+  afterEach(() => {
+    cleanupServer?.()
+    cleanupServer = null
+    process.env = originalEnv
+    if (testDbInstance) {
+      closeAndRemoveDb(testDbInstance, workspaceDir)
