+
+    storage.saveRoom('room-a', 'Owner A Room', 'invite-a', undefined, 'ouA')
+    const getRoom = getRouteHandler(groupChatRoutes, 'GET', '/api/hermes/group-chat/rooms/:roomId')
+
+    const ownerCtx = createCtx({ openid: 'ouA', params: { roomId: 'room-a' } })
