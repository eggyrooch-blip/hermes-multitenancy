;;; gateway-main.sb — sandbox for the multitenancy_router gateway *main*
;;; process (the long-running launchd-managed process that owns the Feishu
;;; websocket, routing table, and AIAgent subprocess spawning).
;;;
;;; ⚠️  STATUS 2026-05-11: NOT IN PRODUCTION USE.
;;;
;;; Phase 2 deploy was attempted but blocked by a Python-toolchain issue,
;;; not a policy gap:
;;;
;;;   * /usr/bin/sqlite3 CLI runs fine inside this policy
;;;     ($ sandbox-exec -f gateway-main.sb -D ... /usr/bin/sqlite3 db
;;;      "SELECT count(*) FROM multitenancy_routing" → 7 ✓)
;;;   * raw open()/flock()/create-file in SHARED_HOME all succeed
;;;   * but Python 3.11.14 (uv-built) sqlite3.connect() raises
;;;     OperationalError: unable to open database file
;;;   * routing.lookup → falls through to "no route", dispatch silently
;;;     fails
;;;
;;; This is a uv-built Python (statically-bundled sqlite 3.50.4) +
;;; sandbox-exec interaction issue; the same probe on /usr/bin/python3
;;; (Apple-shipped) fails differently (xcode-select deny on startup).
;;; Fixing it requires either:
;;;   (a) switch toolchain to brew Python or Apple system Python
;;;   (b) rebuild uv-Python with different sqlite link mode
;;;   (c) ship a separate sqlite-binding shim through subprocess to
;;;       /usr/bin/sqlite3 instead of in-process sqlite3 module
;;;
;;; Phase 1 (per-dispatch AIAgent subprocess sandboxing via
;;; profile-default.sb) is the production deployment as of 2026-05-11.
;;; This gateway-main.sb is checked in as a future starting point;
;;; activate by changing the multitenancy_router plist
;;; ProgramArguments to prepend /usr/bin/sandbox-exec -f
;;; gateway-main.sb -D ... (see Phase 2 design in
;;; docs/profile-isolation.md).
;;;
;;; This is a SUPERSET of profile-default.sb because the gateway main has
;;; legitimate needs the per-tenant subprocess does not:
;;;  - Bind localhost ports (api_server :8643)
;;;  - Read+write ALL profile dirs (routing dispatches dynamically)
;;;  - Spawn /usr/bin/sandbox-exec to wrap each AIAgent subprocess
;;;  - Plugin discovery walks cwd/plugins + ~/.hermes/plugins
;;;  - Maintain shared cron store + multitenancy routing DB
;;;
;;; The gateway main code is "trusted" (our own + upstream hermes-agent,
;;; not LLM-driven), so this policy is less restrictive than the per-
;;; tenant policy. The point of sandbox-izing it is supply-chain defence-
;;; in-depth: limit the blast radius of a bug in lark SDK / hermes-agent
;;; itself.
;;;
;;; Parameters (passed via sandbox-exec -D):
;;;   SHARED_HOME           — ~/.hermes
;;;   USER_HOME             — /Users/<user>
;;;   HERMES_VENV           — Python venv root
;;;   HERMES_AGENT_INSTALL  — venv.parent (editable install root)
;;;   HERMES_AGENT_REPO     — gateway cwd
;;;   HERMES_MT_REPO        — hermes-multitenancy plugin tree

(version 1)
(deny default)
(import "system.sb")

;; ── Process / IPC ─────────────────────────────────────────────────────

(allow process-fork process-exec*)
(allow signal)
(allow mach-lookup)
(allow ipc-posix-shm)
(allow sysctl-read)
(allow sysctl-write)

;; ── File reads — broad, gateway is trusted code ────────────────────────

(allow file-read*
    (subpath "/usr")
    (subpath "/System")
    (subpath "/Library")
    (subpath "/private/var/db")
    (subpath "/private/var/folders")
    (subpath "/private/etc")
    (subpath "/dev")
    (subpath "/opt/homebrew")
    (subpath "/Applications")
    (subpath (param "HERMES_VENV"))
    (subpath (param "HERMES_AGENT_INSTALL"))
    (subpath (param "HERMES_AGENT_REPO"))
    (subpath (param "HERMES_MT_REPO"))
    ;; uv-managed python interpreter
    (subpath (string-append (param "USER_HOME") "/.local/share/uv"))
    ;; gateway must see ALL profiles to know how to route
    (subpath (param "SHARED_HOME"))
    ;; some libs (urllib, requests, certifi) touch ~/.config
    (subpath (string-append (param "USER_HOME") "/.config"))
    ;; system trust stores
    (subpath (string-append (param "USER_HOME") "/.cache")))

;; ── Hard denies — even though we allowed broader subpaths above ───────
;; sandbox-exec is LAST-MATCH-WINS, so these denies (placed after the
;; allows above) take precedence on the listed subpaths.

(deny file-read* file-write*
    (subpath (string-append (param "USER_HOME") "/.ssh"))
    (subpath (string-append (param "USER_HOME") "/Library/Keychains"))
    (subpath (string-append (param "USER_HOME") "/.password-store"))
    (subpath (string-append (param "USER_HOME") "/.aws/credentials")))

;; ── File writes — gateway runtime state ───────────────────────────────

(allow file-write*
    ;; All profile dirs (logs/state/sessions/cron/auth refresh writes)
    (subpath (param "SHARED_HOME"))
    ;; XDG state — gateway puts cross-profile lock files here
    ;; (~/.local/state/hermes/gateway-locks). Discovered during
    ;; 2026-05-11 16:58 bootstrap failure.
    (subpath (string-append (param "USER_HOME") "/.local/state"))
    ;; tmp / per-process scratch
    (subpath "/private/tmp")
    (subpath "/private/var/folders"))

;; sqlite3 in WAL mode needs every sub-op of file-{read,write} PLUS
;; file-ioctl PLUS file-issue-extension PLUS file-map-executable PLUS
;; iokit-* (for shared-memory mmap on .db-shm). Without the full set
;; ``sqlite3.connect(...)`` raises OperationalError: unable to open
;; database file even when raw ``open()`` succeeds.
(allow file-ioctl file-issue-extension file-map-executable
    (subpath (param "SHARED_HOME"))
    (subpath "/private/tmp")
    (subpath "/private/var/folders"))

(allow iokit-open)
(allow iokit-get-properties)
(allow mach-priv-host-port)
(allow mach-priv-task-port)
(allow process-info*)

;; And matching read access for the XDG state dir.
(allow file-read*
    (subpath (string-append (param "USER_HOME") "/.local/state")))

;; ── Network ───────────────────────────────────────────────────────────
;;
;; Gateway main needs:
;;   - Outbound 443/80/53 — Feishu websocket, LLM, plugin updates
;;   - Bind localhost:* — api_server (8643), internal health endpoints
;;   - UNIX socket — asyncio internals, hermes IPC
;;
;; No inbound from external addresses — only localhost bind.

(allow network-outbound
    (remote tcp "*:443")
    (remote tcp "*:80")
    (remote tcp "*:53")
    (remote udp "*:443")
    (remote udp "*:53")
    (remote unix-socket)
    ;; Localhost outbound — needed for the api_server port-conflict probe
    ;; (api_server.py:2713 connects to 127.0.0.1:port before TCPSite.start
    ;; to detect "port already in use"). Without this, the probe gets
    ;; "Operation not permitted" instead of ConnectionRefusedError, which
    ;; surfaces as "Failed to start API server: Operation not permitted".
    (remote tcp "localhost:*"))

;; Note: Apple sandbox grammar restricts (local …) host to "localhost" or
;; "*"; literal IPs like 127.0.0.1 / ::1 are rejected at policy parse. The
;; "localhost" form covers both v4 and v6 loopback at runtime.
(allow network-bind
    (local tcp "localhost:*")
    (local udp "localhost:*")
    (local unix-socket))

;; network-bind covers ``bind()`` but NOT ``listen()`` — those are
;; different sandbox-exec operations. Without network-inbound the
;; api_server gets ``PermissionError: [Errno 1] Operation not permitted``
;; from ``sock.listen()`` deep in asyncio.base_events._start_serving.
;; Confirmed via isolated aiohttp probe 2026-05-11 17:30.
(allow network-inbound
    (local tcp "localhost:*")
    (local udp "localhost:*")
    (local unix-socket))

;; ── Diagnostics — uncomment when chasing a sandbox violation ──────────
;;
;; (debug deny)
